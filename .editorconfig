root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

[*.{kt,kts}]
# Matches Android Studio's own default formatter, rather than ktlint_official's
# stricter/unrelated wrapping rules - avoids fighting the IDE's auto-format.
ktlint_code_style = android_studio
# Jetpack Compose convention: @Composable functions are PascalCase, which the
# standard function-naming rule otherwise flags.
ktlint_function_naming_ignore_when_annotated_with = Composable

[*.{yml,yaml,json}]
indent_size = 2

[*.md]
trim_trailing_whitespace = false
