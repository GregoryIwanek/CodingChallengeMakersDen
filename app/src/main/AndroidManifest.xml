<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" />

    <application
        android:name=".CodingChallengeApp"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.CodingChallenge">

        <activity
            android:name=".MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!--
          Debug-only entry point for the :shared KMP toy feature
          (kmp-interview-prep step 1). No LAUNCHER intent-filter, so it
          stays out of the app drawer/real nav - start it manually:
          adb shell am start -n pl.gi.codingchallenge/.UnitConverterActivity
          exported="false" blocks even this adb command on current Android
          versions (confirmed on this emulator), so exported="true" is
          required here despite there being no intent-filter.
        -->
        <activity
            android:name=".UnitConverterActivity"
            android:exported="true" />

    </application>

</manifest>